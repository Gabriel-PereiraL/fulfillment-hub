# =============================================================================
# FulfillmentHub — .gitignore
# Rule: no private AI files, no secrets and no build artifacts enter the repository.
# =============================================================================

# --- Private AI / operational files (NEVER publish) ---------------------------
CLAUDE.md
.claude/
.ai/
.skills/
.cursor/
.github/copilot-instructions.md
AGENTS.md
*.prompt.md
*.transcript.*
scratch/
scratchpad/
notes-private/

# --- Secrets and local configuration -----------------------------------------
.env
.env.*
!.env.example
appsettings.Local.json
appsettings.*.Local.json
secrets.json
*.pfx
*.p12
*.pem
*.key
*.crt
!**/certs/README.md
aws-credentials*
.aws/
terraform.tfvars
*.auto.tfvars
!example.tfvars

# --- Dumps, data and sensitive artifacts -------------------------------------
*.sql.gz
*.dump
*.bak
*.csv.private
/data/
/dumps/

# --- .NET build --------------------------------------------------------------
bin/
obj/
out/
publish/
artifacts/
TestResults/
*.trx
coverage/
coverage.*.xml
*.coverage
*.snupkg
*.nupkg
!**/packages/**/*.nupkg
BenchmarkDotNet.Artifacts/
.dotnet/
*.binlog

# --- IDEs ----------------------------------------------------------------------
.vs/
.vscode/
!.vscode/extensions.json
!.vscode/launch.json.example
.idea/
*.user
*.suo
*.swp
*.DotSettings.User
*~

# --- Terraform (future phase) -------------------------------------------------
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.*
crash.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# --- Docker / local ----------------------------------------------------------
docker-compose.override.yml
.localstack/
volume/
volumes/

# --- Node (in case the Admin UI needs tooling) --------------------------------
node_modules/

# --- Operating system ---------------------------------------------------------
Thumbs.db
Desktop.ini
.DS_Store
