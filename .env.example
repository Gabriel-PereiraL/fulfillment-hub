# Copy to .env (ignored by Git) and adjust. Local development values only — never real secrets.
POSTGRES_DB=fulfillmenthub
POSTGRES_USER=fh
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5432
LOCALSTACK_PORT=4566
# otel-lgtm (Grafana + Prometheus + Tempo + Loki): UI, OTLP gRPC/HTTP, Prometheus API
GRAFANA_PORT=3000
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318
PROMETHEUS_PORT=9090
# Optional Aspire Dashboard (profile "aspire")
ASPIRE_DASHBOARD_PORT=18888
ASPIRE_OTLP_PORT=4327
# Profile "app" (containers). JWT key: any 32+ random characters; seed passwords: 12+ characters (fictional users).
JWT_SIGNING_KEY=change-me-to-at-least-32-random-characters
SEED_ADMIN_PASSWORD=change-me-admin-12
SEED_OPERATOR_PASSWORD=change-me-operator-12
SEED_CUSTOMER_PASSWORD=change-me-customer-12
API_PORT=5000
SIMULATOR_PORT=5100
# Provider keys default to the simulator's public dev-only values; override only if you change the simulator's too.
