# Copy to .env (ignored by Git) and adjust. Local development values only — never real secrets.
POSTGRES_DB=fulfillmenthub
POSTGRES_USER=fh
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5432
LOCALSTACK_PORT=4566
# otel-lgtm (Grafana + Prometheus + Tempo + Loki): UI, OTLP gRPC/HTTP, Prometheus API
GRAFANA_PORT=3000
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318
PROMETHEUS_PORT=9090
# Optional Aspire Dashboard (profile "aspire")
ASPIRE_DASHBOARD_PORT=18888
ASPIRE_OTLP_PORT=4327
