{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "ConnectionString": "",
    "CommandTimeoutSeconds": 30
  },
  "Providers": {
    "Payment": {
      "BaseUrl": "http://localhost:5100",
      "ApiKey": "",
      "WebhookSigningKey": "",
